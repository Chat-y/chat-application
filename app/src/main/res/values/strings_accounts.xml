    <string name="accounts_delete_title">Delete Account?</string>
    <!-- Previous copy: This will permanently delete your user profile, message history, and remove you from all workspaces. This action is irreversible. -->
    <string name="accounts_delete_body">This requests deletion of your account and clears this account\'s local data after the request succeeds. The app cannot confirm server retention or removal from every workspace or device. A successful deletion cannot be undone here.</string>
